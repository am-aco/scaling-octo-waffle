NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_rnd
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Database URL for migrations (node-pg-migrate)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/auth_rnd

# JWT (Phase 9A - Pure JWT with longer expiration)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# JWT Refresh Token (Phase 9B - Short access tokens + long refresh tokens)
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
